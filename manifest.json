{
  "manifest_version": 3,
  "name": "TabSQL",
  "version": "0.1.0",
  "description": "Tab manager with SQLite/MariaDB backend and SQL console",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabSQL"
  },
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "nativeMessaging",
    "favicon",
    "system.display",
    "clipboardWrite"
  ],
  "commands": {
    "open_sidebar": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Open TabSQL"
    }
  },
  "web_accessible_resources": [{
    "resources": ["index.html", "management_ui.html"],
    "matches": ["<all_urls>"]
  }]
}
